DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bogota_realestate?schema=public"

# Auth.js (NextAuth v5): session/JWT signing secret. Generate with:
# openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app, used for absolute links/metadata
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public map tile provider (OpenStreetMap standard tiles by default)
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Placeholder image domain(s), used to configure next/image remote patterns
NEXT_PUBLIC_IMAGE_HOST="images.unsplash.com"

# --- Future integrations (not required for MVP) ---
# WhatsApp Business Cloud API credentials, wired through src/services/whatsapp.service.ts
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# CRM/lead webhook, wired through src/services/lead.service.ts
CRM_WEBHOOK_URL=""
