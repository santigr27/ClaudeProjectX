// Prisma schema for the Bogotá real estate marketplace MVP.
// See docs/architecture.md for an overview of how these models are used.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- White-label marketplace configuration ---------------------------------
// Single-row config for the ONE active marketplace this deployment serves
// (see docs: multi-tenant SaaS is an explicit non-goal for the MVP). Reading
// this at request time — instead of baking values into globals.css — is what
// lets an admin rebrand the marketplace without a rebuild/redeploy.
model MarketplaceConfig {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  tagline     String
  description String

  logoUrl          String?
  secondaryLogoUrl String?
  faviconUrl       String?

  // Single hex per role; the full brand-50..900 scale used by globals.css is
  // derived from `primaryColor` at render time via CSS color-mix(), so admins
  // never have to pick nine coordinated shades themselves.
  primaryColor    String @default("#1d4ed8")
  secondaryColor  String @default("#0f172a")
  accentColor     String @default("#2f7d57")
  backgroundColor String @default("#f8fafc")

  defaultCurrency String @default("COP")
  defaultLocale   String @default("es-CO")
  country         String?
  marketplaceType String  @default("real_estate")

  supportEmail String?
  supportPhone String?

  // Record<TerminologyKey, string> — see src/config/terminology.ts for the
  // key list and defaults; missing keys fall back to the generic defaults so
  // a partial config never breaks rendering.
  terminology     Json?
  // Ordered list of homepage section keys to render — see
  // src/config/homepage-sections.ts for the recognized keys.
  homepageSections Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Simple on/off switches for optional marketplace modules (cart, reviews,
// seller approval, ...). Checked server-side wherever a module is optional;
// absence of a row for a key means "disabled" (see feature-flags.repository).
model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  enabled     Boolean @default(false)
  description String?

  updatedAt DateTime @updatedAt
}

enum ListingType {
  SALE
  RENT
}

enum PropertyType {
  APARTMENT
  HOUSE
  STUDIO
  PENTHOUSE
  COMMERCIAL
  LOT
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
  DISCARDED
}

model Property {
  id                String         @id @default(cuid())
  slug              String         @unique
  title             String
  description       String
  listingType       ListingType
  propertyType      PropertyType
  price             Float
  administrationFee Float?
  areaSqm           Float
  bedrooms          Int
  bathrooms         Int
  parkingSpaces     Int            @default(0)
  estrato           Int?
  floor             Int?
  propertyAge       Int?
  address           String
  locality          String
  neighborhood      String
  latitude          Float
  longitude         Float
  status            PropertyStatus @default(PUBLISHED)
  featured          Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id])

  // The platform account that submitted/manages this listing. Nullable
  // because the seeded demo catalog wasn't created by any registered user.
  // Distinct from `agent`, which is just the contact shown on the listing.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  images    PropertyImage[]
  amenities PropertyAmenity[]
  leads     Lead[]
  favorites Favorite[]

  @@index([listingType, status])
  @@index([locality, neighborhood])
  @@index([propertyType])
  @@index([latitude, longitude])
  @@index([ownerId])
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  imageUrl   String
  sortOrder  Int      @default(0)
  alt        String?

  // Present only for user-uploaded photos, stored directly in Postgres so
  // the MVP needs no external object storage (see PropertyImageService).
  // Seed/placeholder images leave these null and only set `imageUrl`.
  fileName  String?
  mimeType  String?
  fileSize  Int?
  imageData Bytes?

  @@index([propertyId])
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties Property[]
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Agent {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String
  whatsapp  String?
  imageUrl  String?
  title     String?
  createdAt DateTime @default(now())

  properties Property[]
  leads      Lead[]
}

model Lead {
  id         String     @id @default(cuid())
  propertyId String?
  property   Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  agentId    String?
  agent      Agent?     @relation(fields: [agentId], references: [id])
  name       String
  email      String
  phone      String?
  message    String
  status     LeadStatus @default(NEW)
  createdAt  DateTime   @default(now())

  @@index([propertyId])
  @@index([status])
}

// Mock/demo market data used to power the valuation estimator.
// Intended to be replaced by a real comparable-sales dataset or external API.
model NeighborhoodMarketData {
  id              String   @id @default(cuid())
  locality        String
  neighborhood    String
  salePricePerSqm Float
  rentPricePerSqm Float
  updatedAt       DateTime @updatedAt

  @@unique([locality, neighborhood])
}

model Favorite {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  sessionId  String
  createdAt  DateTime @default(now())

  @@unique([propertyId, sessionId])
  @@index([sessionId])
}
